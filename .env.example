# SQLite ファイルの場所 (省略時 data/whisky_ai.sqlite3)
WHISKY_AI_DB=data/whisky_ai.sqlite3

# --- 価格収集 PR (次段階) で使用。リポジトリにコミットしないこと ---
# 楽天ウェブサービス: アプリ登録で発行される applicationId / accessKey
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アプリ登録時に指定したサイト URL (新 API は Referer 検証あり)
RAKUTEN_REFERER=
# 任意: 楽天アフィリエイト ID
RAKUTEN_AFFILIATE_ID=
# Yahoo!デベロッパーネットワーク Client ID (アプリケーション ID)
YAHOO_CLIENT_ID=
